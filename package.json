{
  "name": "@mye-org/eslint-plugin-strict-fp",
  "version": "0.1.0",
  "description": "A very strict TypeScript ESLint plugin enforcing functional programming style with fp-ts, ts-pattern, monocle-ts, and newtype-ts.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@typescript-eslint/utils": "^8.30.0",
    "fp-ts": "^2.16.9",
    "ts-pattern": "^5.6.2",
    "typescript-eslint": "^8.30.0"
  },
  "peerDependencies": {
    "eslint": "^9.0.0",
    "typescript": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@typescript-eslint/parser": "^8.30.0",
    "@typescript-eslint/rule-tester": "^8.30.0",
    "@vitest/coverage-v8": "^3.1.1",
    "eslint": "^9.24.0",
    "jiti": "^2.7.0",
    "monocle-ts": "^2.3.13",
    "newtype-ts": "^0.3.5",
    "typescript": "^5.8.2",
    "vitest": "^3.1.1"
  }
}
